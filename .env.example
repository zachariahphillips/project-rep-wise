# Copy this file to .env and fill in real values. .env is gitignored.
#
# RepWise needs no AI API key. Every core feature is deterministic Python
# (see "The zero-token rule" in PLAN.md).

# Long random string used to sign session cookies.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Flask debug + run config (override only if you need to)
FLASK_ENV=development
FLASK_DEBUG=1

# --- deploy knobs (Phase 2) ---
# Keep DATABASE_URL absolute (4 slashes) in production so SQLite lands in the
# intended data directory, not Flask's instance folder.
# DATABASE_URL=sqlite:////home/<your-pythonanywhere-username>/project-rep-wise/data/repwise.sqlite3
# PythonAnywhere's free tier is a network filesystem; use DELETE there.
# SQLITE_JOURNAL_MODE=DELETE
